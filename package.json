{
  "name": "mantine-vite-template",
  "version": "1.0.0",
  "homepage": "https://progbeat.github.io/cubetimer365/",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "npm run eslint && npm run stylelint",
    "eslint": "eslint . --cache",
    "stylelint": "stylelint '**/*.css' --cache",
    "prettier": "prettier --check \"**/*.{ts,tsx}\"",
    "prettier:write": "prettier --write \"**/*.{ts,tsx}\"",
    "vitest": "vitest run",
    "vitest:watch": "vitest",
    "test": "npm run typecheck && npm run prettier && npm run lint && npm run vitest && npm run build",
    "browser-check": "node scripts/review/run-browser-checks.mjs"
  },
  "dependencies": {
    "@mantine/charts": "^7.13.4",
    "@mantine/core": "^7.13.4",
    "@mantine/hooks": "^7.13.4",
    "@tabler/icons-react": "^3.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@ianvs/prettier-plugin-sort-imports": "^4.3.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.12.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.39.4",
    "eslint-config-mantine": "^4.0.3",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.1",
    "jsdom": "^25.0.1",
    "playwright": "1.64.0",
    "postcss": "^8.5.23",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "3.3.3",
    "stylelint": "^17.16.0",
    "terser": "^5.51.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.5",
    "vitest": "^4.1.11"
  },
  "packageManager": "yarn@4.5.1"
}
